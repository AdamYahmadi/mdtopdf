#!/usr/bin/env python3

import sys
import os
import argparse
import subprocess
import tempfile
import shutil

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
RENDER_JS = os.path.join(SCRIPT_DIR, 'render.js')


def find_chrome():
    candidates = [
        '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
        '/Applications/Chromium.app/Contents/MacOS/Chromium',
        '/Applications/Brave Browser.app/Contents/MacOS/Brave Browser',
        'google-chrome', 'google-chrome-stable',
        'chromium', 'chromium-browser',
        r'C:\Program Files\Google\Chrome\Application\chrome.exe',
        r'C:\Program Files (x86)\Google\Chrome\Application\chrome.exe',
    ]
    for c in candidates:
        if os.path.isfile(c):
            return c
        found = shutil.which(c)
        if found:
            return found
    return None


def convert(input_file, output_file, theme=None, size=None):

    tmp_html = tempfile.NamedTemporaryFile(suffix='.html', delete=False)
    tmp_html.close()

    try:
        cmd = ['node', RENDER_JS, os.path.abspath(input_file), tmp_html.name]
        if theme:
            cmd += ['--theme', theme]
        if size:
            cmd += ['--size', str(size)]
        subprocess.run(cmd, check=True, capture_output=True)

        chrome = find_chrome()
        if not chrome:
            print("Error: Chrome not found. Install from https://www.google.com/chrome/", file=sys.stderr)
            sys.exit(1)

        subprocess.run([
            chrome,
            '--headless=new',
            '--no-sandbox',
            '--disable-gpu',
            '--disable-dev-shm-usage',
            '--run-all-compositor-stages-before-draw',
            f'--print-to-pdf={os.path.abspath(output_file)}',
            '--print-to-pdf-no-header',
            '--no-pdf-header-footer',
            f'file://{tmp_html.name}'
        ], check=True, capture_output=True)

    finally:
        os.unlink(tmp_html.name)

    print(f"✓ {output_file}")


SIZE_MIN, SIZE_MAX, SIZE_DEFAULT = 8, 28, 13


def font_size(value):
    try:
        size = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"'{value}' is not an integer")
    if not SIZE_MIN <= size <= SIZE_MAX:
        raise argparse.ArgumentTypeError(
            f"size must be between {SIZE_MIN} and {SIZE_MAX} (got {size})"
        )
    return size


def main():
    themes = ['light', 'github', 'github-dark', 'one-dark', 'tokyo-night']
    parser = argparse.ArgumentParser(
        prog='mdtopdf',
        description='Convert markdown to PDF (with LaTeX math and code highlighting)'
    )
    parser.add_argument('input', help='input .md file')
    parser.add_argument('-o', '--output', help='output .pdf file (default: same name as input)')
    parser.add_argument(
        '-t', '--theme', choices=themes, default='light', metavar='NAME',
        help='code highlighting theme: ' + ', '.join(themes) + ' (default: light)'
    )
    parser.add_argument(
        '-s', '--size', type=font_size, default=SIZE_DEFAULT, metavar='N',
        help=f'base text size in px, {SIZE_MIN}-{SIZE_MAX} (default: {SIZE_DEFAULT})'
    )
    args = parser.parse_args()

    if not os.path.exists(args.input):
        print(f"Error: file not found: {args.input}", file=sys.stderr)
        sys.exit(1)

    output = args.output or os.path.splitext(args.input)[0] + '.pdf'
    convert(args.input, output, args.theme, args.size)


if __name__ == '__main__':
    main()
